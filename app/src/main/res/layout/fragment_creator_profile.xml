<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F15">

    <!-- 1. THANH TIÊU ĐỀ (Top Header Bar) -->
    <LinearLayout
        android:id="@+id/topBarProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="HỒ SƠ CREATOR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#00F3FF" />
    </LinearLayout>

    <!-- 2. NỘI DUNG CUỘN HỒ SƠ (ScrollView) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/includedBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarProfile">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- THẺ THÔNG TIN CÁ NHÂN (Profile Summary Card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A24"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#2A2A35"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#00FF66" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Lê Anh Quốc ✔"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoleMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@QuocDev • Full-stack &amp; Mobile Developer"
                    android:textColor="#00F3FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvUniversityTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#2A2A35"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🎓 UTE Đà Nẵng • Khoa CNTT"
                    android:textColor="#A0A0B0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="&quot;Xây dựng hệ sinh thái bản đồ vị trí cho sinh viên IT. Đang phát triển ứng dụng DevSpot.&quot;"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <!-- Nút Chỉnh sửa Hồ sơ -->
                <Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#2A2A35"
                    android:text="✏️ CHỈNH SỬA HỒ SƠ"
                    android:textColor="#00F3FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CHỈ SỐ TELEMETRY / THỐNG KÊ (Stats Cards) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Dự án đã ghim -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#1A1A24"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvPinnedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08"
                        android:textColor="#00FF66"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dự án đã ghim"
                        android:textColor="#A0A0B0"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Lượt quét Signal -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#1A1A24"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvSignalViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.4k"
                        android:textColor="#00F3FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lượt quét Signal"
                        android:textColor="#A0A0B0"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Xếp hạng Hub -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#1A1A24"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top 5%"
                        android:textColor="#00FF66"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hub Đà Nẵng"
                        android:textColor="#A0A0B0"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CHỈ SỐ KỸ NĂNG // TECH STACK -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="💻 CHỈ SỐ KỸ NĂNG // TECH STACK"
                android:textColor="#00F3FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CORE: Kotlin • Java • ASP.NET Core • SQL Spatial"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TOOLS: GitFlow • Android Studio • OSMDroid • Docker"
                    android:textColor="#A0A0B0"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- TIÊU ĐỀ DANH SÁCH DỰ ÁN ĐÃ GHIM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📌 DỰ ÁN ĐÃ GHIM (8)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddNewProject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ THÊM DỰ ÁN"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DANH SÁCH THẺ DỰ ÁN (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPinnedProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_pinned_project_card" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. NHÚNG THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
    <include
        android:id="@+id/includedBottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>