<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F15">

    <!-- 1. THANH TIÊU ĐỀ CHAT (Top Bar) -->
    <LinearLayout
        android:id="@+id/topBarChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackFromChat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="#2A2A35"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#00F3FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatPartnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Tuấn Kiệt"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online • ĐH Sư phạm Kỹ thuật"
                android:textColor="#00FF66"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. DANH SÁCH TIN NHẮN (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarChat"
        tools:listitem="@layout/item_chat_message_received" />

    <TextView
        android:id="@+id/tvChatEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="Chưa có tin nhắn. Hãy gửi lời chào để bắt đầu cuộc trò chuyện."
        android:textColor="@color/text_sub"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarChat" />

    <TextView
        android:id="@+id/tvChatFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/neon_green"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. KHUNG NHẬP TIN NHẮN (Input Bar) -->
    <LinearLayout
        android:id="@+id/layoutInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Nút đính kèm file/repo -->
        <ImageView
            android:id="@+id/btnAttachFile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#A0A0B0" />

        <!-- Ô nhập nội dung tin nhắn -->
        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="#2A2A35"
            android:hint="Nhập tin nhắn..."
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0A0B0"
            android:textSize="14sp" />

        <!-- Nút Gửi tin nhắn -->
        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#00FF66"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#000000" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>