<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F15"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="CHI TIẾT ĐỒ ÁN RADAR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnBookmark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#00F3FF" />
        </LinearLayout>

        <!-- Ảnh Demo / Screenshot -->
        <ImageView
            android:id="@+id/ivProjectImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:background="#1A1A24"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:tint="#2A2A35" />

        <!-- Tên Đồ án & Tác giả -->
        <TextView
            android:id="@+id/tvProjectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DevSpot Location-Based Hub"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tác giả: Lê Anh Quốc • UTE Đà Nẵng"
            android:textColor="#00FF66"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLikeProject"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A35"
                android:text="♡ Thích"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/btnFollowCreator"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A35"
                android:text="＋ Theo dõi"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/btnOpenComments"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A35"
                android:text="Bình luận"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <!-- Tagline & Mô tả -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nền tảng mạng xã hội kết nối sinh viên IT và nhà tuyển dụng theo tọa độ GPS thời gian thực. Tích hợp OpenStreetMap và backend C# ASP.NET Core."
            android:textColor="#A0A0B0"
            android:textSize="14sp" />

        <!-- Tech Stack -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🛠 CÔNG NGHỆ SỬ DỤNG"
            android:textColor="#00F3FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTechStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A24"
            android:padding="12dp"
            android:text="Kotlin • Android SDK • OSMDroid • C# ASP.NET Core • Spatial SQL"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutProjectComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THẢO LUẬN CỘNG ĐỒNG"
                android:textColor="@color/neon_blue"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProjectComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1A1A24"
                android:hint="Chia sẻ nhận xét về dự án..."
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />

            <Button
                android:id="@+id/btnPostComment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/bg_panel"
                android:text="GỬI BÌNH LUẬN"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvCommentFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/neon_green"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Link liên kết Repo / Demo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenGithub"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A35"
                android:text="🔗 GitHub Repo"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenDemo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A35"
                android:text="🌐 Live Demo"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nút gửi Lời mời / Nhắn tin -->
        <Button
            android:id="@+id/btnActionInvite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#00FF66"
            android:text="⚡ GỬI LỜI MỜI PHỎNG VẤN TRỰC TIẾP"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>