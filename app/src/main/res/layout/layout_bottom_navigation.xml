<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#0F0F15"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Tab 1: Bản đồ / Radar -->
    <LinearLayout
        android:id="@+id/navMap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavMap"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RADAR"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tab 2: Cụm Node -->
    <LinearLayout
        android:id="@+id/navClusters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavClusters"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavClusters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="KHÁM PHÁ"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tab 3: Tín hiệu -->
    <LinearLayout
        android:id="@+id/navSignal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavSignal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TIN BÁO"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tab 4: Đã lưu -->
    <LinearLayout
        android:id="@+id/navSaved"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavSaved"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_save"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ĐÃ LƯU"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tab 5: Tin nhắn -->
    <LinearLayout
        android:id="@+id/navMessages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavMessages"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TIN NHẮN"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#A0A0B0" />

        <TextView
            android:id="@+id/tvNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="HỒ SƠ"
            android:textColor="#A0A0B0"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>