<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F15">

    <!-- 1. THANH TIÊU ĐỀ (Top Bar) -->
    <LinearLayout
        android:id="@+id/topBarPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A24"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="THẢ GHIM DỰ ÁN"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2A2A35"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="● ONLINE"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. NỘI DUNG CUỘN FORM NHẬP LỆU (ScrollView) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/includedBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarPin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD THÔNG TIN TỌA ĐỘ RADAR GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A24"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📍 TỌA ĐỘ RADAR GPS"
                        android:textColor="#00F3FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐÃ KHÓA TỌA ĐỘ"
                        android:textColor="#00FF66"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCoordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="16.0759° N, 108.1534° E"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Khu vực ĐH Sư phạm Kỹ thuật Đà Nẵng (UD-UTE)"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 1. TÊN DỰ ÁN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="// TÊN DỰ ÁN *"
                android:textColor="#A0A0B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProjectName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:hint="VD: DevSpot Radar Scanner"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="13sp" />

            <!-- 2. TAGLINE / MÔ TẢ NGẮN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="// TAGLINE / MÔ TẢ NGẮN (MAX 128 KÝ TỰ)"
                android:textColor="#A0A0B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTagline"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:gravity="top"
                android:hint="Mô tả ngắn gọn về giải pháp trong 1 câu"
                android:inputType="textMultiLine"
                android:maxLength="128"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="13sp" />

            <!-- 3. LIÊN KẾT GITHUB REPO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="// LIÊN KẾT GITHUB REPO"
                android:textColor="#A0A0B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGithubRepo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:hint="https://github.com/username/project"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="12sp" />

            <!-- 4. DEMO HOẶC TÀI LIỆU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="// DEMO HOẶC TÀI LIỆU"
                android:textColor="#A0A0B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDemoUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:drawableStart="@android:drawable/ic_menu_send"
                android:drawablePadding="10dp"
                android:hint="https://demo.devspot.vn hoặc Figma link"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="12sp" />

            <!-- 5. KỸ NĂNG & CÔNG NGHỆ (TECH STACK) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="// KỸ NĂNG &amp; CÔNG NGHỆ (TECH STACK)"
                android:textColor="#00F3FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTechStack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:hint="VD: Kotlin, ASP.NET Core, React, SQL Server"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="13sp" />

            <!-- 6. KHUNG CHỌN ÁNH SCREENSHOT GIAO DIỆN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="// ÁNH SCREENSHOT GIAO DIỆN"
                android:textColor="#A0A0B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSelectScreenshot"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:background="#1A1A24"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:tint="#00F3FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chạm để chọn ảnh screenshot dự án"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="PNG, JPG tối đa 10MB • Tỷ lệ khuyến nghị 16:9"
                    android:textColor="#555555"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Spacer đẩy nút bấm xuống -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 7. NÚT XÁC NHẬN & PHÁT TÍN HIỆU DỰ ÁN -->
            <Button
                android:id="@+id/btnSubmitPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#00FF66"
                android:text="📡 XÁC NHẬN &amp; PHÁT TÍN HIỆU DỰ ÁN"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. NHÚNG THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
    <include
        android:id="@+id/includedBottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>