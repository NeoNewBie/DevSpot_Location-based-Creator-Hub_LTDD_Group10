<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F15">

    <!-- 1. BẢN ĐỒ NỀN OpenTopoMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. THANH CÔNG CỤ PHÍA TRÊN & THANH TÌM KIẾM (Top Bar & Search) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC0F0F15"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tiêu đề & Mode Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEVSPOT"
                android:textColor="#00F3FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1A1A24"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="Recruiter"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnHomeMessages"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="#1A1A24"
                android:contentDescription="Tin nhắn"
                android:padding="7dp"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="#00FF66" />

            <ImageView
                android:id="@+id/btnHomeNotifications"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="#1A1A24"
                android:contentDescription="Thông báo"
                android:padding="7dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:tint="#00F3FF" />

            <ImageView
                android:id="@+id/btnHomeSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Cài đặt"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Ô Tìm kiếm nhanh Talent / Tech Stack -->
        <EditText
            android:id="@+id/etSearchTalent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#1A1A24"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="Tìm theo Java, Kotlin, React, AI..."
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0A0B0"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#CC1A1A24"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="Đang kiểm tra quyền vị trí..."
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <TextView
        android:id="@+id/tvMapDemoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#CC1A1A24"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="DỮ LIỆU MẪU • chạm ghim để xem"
        android:textColor="#00FF66"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLocationStatus" />

    <TextView
        android:id="@+id/tvMapAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#CC1A1A24"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/map_attribution"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/bottomControlPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. KHUNG ĐIỀU KHIỂN BÊN DƯỚI (Bottom Dashboard Panel) -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E61A1A24"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation">

        <!-- Thông tin số lượng Ghim xung quanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#2A2A35"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#00FF66" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RADAR KHU VỰC ĐÀ NẴNG"
                    android:textColor="#A0A0B0"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvTalentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28 Đồ án &amp; 15 ứng viên sẵn sàng"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bán kính 5km"
                android:textColor="#00F3FF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- NÚT HÀNH ĐỘNG CHÍNH: LỌC TÀI NĂNG -->
        <Button
            android:id="@+id/btnFilterRadar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#00FF66"
            android:text="🔍 QUÉT BÁN KÍNH &amp; LỌC TÀI NĂNG"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenCandidate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A2A35"
            android:text="XEM HỒ SƠ ỨNG VIÊN GẦN BẠN"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 4. THANH ĐIỀU HƯỚNG ĐÁY (Bottom Navigation) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#0F0F15"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navRecruiterRadar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_compass"
                android:tint="#00FF66" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radar"
                android:textColor="#00FF66"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecruiterSaved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#A0A0B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã lưu"
                android:textColor="#A0A0B0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecruiterCompany"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#A0A0B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Công ty"
                android:textColor="#A0A0B0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>