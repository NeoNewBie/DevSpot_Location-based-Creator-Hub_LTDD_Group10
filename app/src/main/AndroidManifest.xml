        <activity android:name=".view.RegisterRecruiterActivity" android:exported="false" />
        <activity android:name=".view.ChatDetailActivity" android:exported="false" />
        <activity android:name=".view.InterviewDispatchActivity" android:exported="false" />
        <activity android:name=".view.InterviewSuccessActivity" android:exported="false" />
        <activity android:name=".view.LogoutConfirmActivity" android:exported="false" />
        -->

    </application>

</manifest>